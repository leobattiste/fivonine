# Public site URL (used for share links, OG images, emails)
NEXT_PUBLIC_SITE_URL=https://fivonine.com

# Supabase — leave blank to run on the bundled content in lib/content.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM="Fivonine <lettre@fivonine.com>"

# Protects /api/cron/* (Vercel sends it automatically as a Bearer token)
CRON_SECRET=

# Contribute page: where new contributions are emailed (optional if Supabase is set)
CONTRIBUTE_NOTIFY_EMAIL=

# Donate page: your Stripe Payment Link, PayPal, Ko-fi or GoFundMe URL
NEXT_PUBLIC_DONATE_URL=
