NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Indexing also requires every readiness check below. Keep false during the pilot.
PUBLIC_LAUNCH=false
# Set true only after Auth SMTP, the verified sending domain, admin ownership,
# delivery tests, policies, moderation and operational QA have passed.
LAUNCH_CHECKS_PASSED=false
# Owner-supplied public operator and support details. Do not use example identities.
SITE_OPERATOR_NAME=
SITE_OPERATOR_COUNTRY=
SITE_SUPPORT_EMAIL=
# The actual, owner-approved verification-document retention policy.
SITE_DOCUMENT_RETENTION=
# Server-only. Matches the hash stored in private.backend_credentials. Used only to send queued emails.
APP_BACKEND_SECRET=
# Required for launch notification emails. Never expose these in the browser.
RESEND_API_KEY=
# Verified sender, e.g. a display name and an address on your own verified domain.
RESEND_FROM=
# Vercel sends this as a bearer token to /api/cron.
CRON_SECRET=
