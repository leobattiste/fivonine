NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep false until the pilot is done. When false, search engines are told not to index the site.
PUBLIC_LAUNCH=false
# Server-only. Matches the hash stored in private.backend_credentials. Used only to send queued emails.
APP_BACKEND_SECRET=
# Notification emails (optional until configured). Never expose these in the browser.
RESEND_API_KEY=
RESEND_FROM=
# Vercel sends this as a bearer token to /api/cron.
CRON_SECRET=
